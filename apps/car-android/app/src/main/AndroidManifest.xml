<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- 알림에 "응/아니"로 답하기(안드로이드 SpeechRecognizer). 없으면 화면 버튼만 쓴다. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:usesCleartextTraffic="true"
        android:theme="@android:style/Theme.Material.NoActionBar">
        <!-- usesCleartextTraffic: 시연용 PC 서버(http://10.0.2.2:8787) 전용. 배포 때는 false + TLS -->
        <uses-library android:name="android.car" android:required="false" />
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|density|uiMode">
            <!-- 주행 중에도 화면이 막히지 않게(AAOS 주행 최적화 표시). 실제로 허용되는지는 G0 확인 항목 -->
            <meta-data android:name="distractionOptimized" android:value="true" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Gleo AI 음성 기능(assets/schema.json의 actionCalls, 최대 3개). Gleo가 startActivity(action, extra ACTION_PARAM)로 부른다.
                 singleTask라 떠 있는 화면이 onNewIntent로 받는다. 응답은 APP_ACTION_RESPONSE 브로드캐스트(7초 안) -->
            <intent-filter>
                <action android:name="ADD_INTEREST" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter>
                <action android:name="ANSWER_ALERT" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter>
                <action android:name="SHOW_BRIEFING" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
    </application>
</manifest>
